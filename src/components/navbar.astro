---
import finder from "../../public/res/finder.png";
---

<header>
  <section>
    <a><img src="/res/finder.png" alt="Finder" height="50px" /></a>
    <a><img src="/res/safari.png" alt="Safari" height="50px" /></a>
    <a><img src="/res/imessage.png" alt="iMessage" height="50px" /></a>
  </section>
</header>

<style>
  header {
    width: 100%;
    height: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    top: -65px;
    /* bottom: 14px; */
    transition: all 0.2s ease-in-out;
  }

  header:hover {
    top: 0px;
    transition: top 0.2s ease-in-out;
  }

  header section {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.35) 0%,
      rgba(200, 200, 255, 0.25) 100%
    );
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    padding: 10px;
    border-radius: 25px;
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    color: #222;
    text-align: center;
    width: 60vw;
    height: 50px;
    margin: auto;
    display: inline-flex;
    gap: 1rem;
    justify-content: center;
    align-items: flex-end;
  }

  header section a {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    font-size: 1.6rem;
    transition:
      transform 0.01s linear,
      box-shadow 0.18s;
    cursor: pointer;
    border: none;
    width: auto;
    aspect-ratio: 1;
  }

  header section a:hover {
    z-index: 2;
  }

  header section a:active {
    transform: translateY(-10px);
  }
</style>
